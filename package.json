{
  "name": "stupid-censor",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "description": "stupidCensor: PulseSync addon for cloud-hosted replacement of censored Yandex Music tracks",
  "author": "xaunds",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "format": "oxfmt .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "yarn build && yarn sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:worker": "python3 -m unittest discover -s tests/worker -v",
    "test": "yarn typecheck && yarn test:worker && yarn build",
    "build:legacy": "node ./scripts/build-legacy.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.71.0",
    "react": "19.3.0",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
